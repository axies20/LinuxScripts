<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-csharp">
    <comment>C# source code</comment>
    <glob pattern="*.cs"/>
    <glob pattern="*.csx"/>
  </mime-type>
  <mime-type type="application/x-dotnet-project">
    <comment>.NET project</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.csproj"/>
    <glob pattern="*.fsproj"/>
    <glob pattern="*.vbproj"/>
  </mime-type>
  <mime-type type="application/x-dotnet-solution">
    <comment>.NET solution</comment>
    <glob pattern="*.sln"/>
    <glob pattern="*.slnx"/>
  </mime-type>
  <mime-type type="application/x-msbuild-project">
    <comment>MSBuild project/configuration</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.props"/>
    <glob pattern="*.targets"/>
    <glob pattern="*.ruleset"/>
  </mime-type>
  <mime-type type="text/x-razor">
    <comment>Razor component or view</comment>
    <glob pattern="*.razor"/>
    <glob pattern="*.cshtml"/>
  </mime-type>
  <mime-type type="text/x-http-request">
    <comment>HTTP request file</comment>
    <glob pattern="*.http"/>
    <glob pattern="*.rest"/>
  </mime-type>
  <mime-type type="application/graphql">
    <comment>GraphQL document</comment>
    <glob pattern="*.graphql"/>
    <glob pattern="*.gql"/>
  </mime-type>
  <mime-type type="text/x-protobuf">
    <comment>Protocol Buffers schema</comment>
    <glob pattern="*.proto"/>
  </mime-type>
  <mime-type type="text/x-hcl">
    <comment>HashiCorp Configuration Language</comment>
    <glob pattern="*.hcl"/>
    <glob pattern="*.tf"/>
    <glob pattern="*.tfvars"/>
  </mime-type>
  <mime-type type="application/x-ndjson">
    <comment>Newline-delimited JSON</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.ndjson"/>
    <glob pattern="*.jsonl"/>
  </mime-type>
  <mime-type type="application/vnd.apache.parquet">
    <comment>Apache Parquet data</comment>
    <glob pattern="*.parquet"/>
  </mime-type>
  <mime-type type="application/vnd.apache.arrow.file">
    <comment>Apache Arrow file</comment>
    <glob pattern="*.arrow"/>
  </mime-type>
  <mime-type type="application/avro">
    <comment>Apache Avro data</comment>
    <glob pattern="*.avro"/>
  </mime-type>
  <mime-type type="text/x-template">
    <comment>Template source</comment>
    <glob pattern="*.jinja"/>
    <glob pattern="*.jinja2"/>
    <glob pattern="*.hbs"/>
    <glob pattern="*.mustache"/>
  </mime-type>
  <mime-type type="text/x-prompty">
    <comment>Prompty AI prompt file</comment>
    <glob pattern="*.prompty"/>
  </mime-type>
  <mime-type type="text/x-containerfile">
    <comment>Container build file</comment>
    <glob pattern="Dockerfile"/>
    <glob pattern="Dockerfile.*"/>
    <glob pattern="Containerfile"/>
    <glob pattern="Containerfile.*"/>
  </mime-type>
  <mime-type type="text/x-build-script">
    <comment>Build automation file</comment>
    <glob pattern="Makefile"/>
    <glob pattern="CMakeLists.txt"/>
    <glob pattern="Justfile"/>
    <glob pattern="Taskfile"/>
    <glob pattern="Procfile"/>
    <glob pattern="Vagrantfile"/>
  </mime-type>
</mime-info>
